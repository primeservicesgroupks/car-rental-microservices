# =========================================================
# DATABASE CONFIGURATION
# =========================================================

# Local PostgreSQL database used by the User Service.
#
# This credential is only for our local Docker learning
# environment. Production credentials must be managed
# securely and must not be committed to Git.

DATABASE_URL=postgresql+psycopg://car_app:local_dev_only@127.0.0.1:5433/car_rental


# =========================================================
# JWT AUTHENTICATION CONFIGURATION
# =========================================================

# Secret used by the API to sign and verify JWT access tokens.
#
# This value is ONLY an example.
#
# Never put the real JWT secret in .env.example.

JWT_SECRET_KEY=replace_with_a_long_random_local_dev_secret


# Algorithm used to sign JWT access tokens.

JWT_ALGORITHM=HS256


# Number of minutes before an access token expires.
#
# 30 minutes is appropriate for this learning project.

ACCESS_TOKEN_EXPIRE_MINUTES=30